# Configuración de la API. Copie este archivo a `.env` y ajústelo.
# El `.env` real no se versiona (lleva credenciales locales).

# Conexión a Postgres. Debe apuntar al rol de aplicación (no superusuario).
DATABASE_URL=postgres://fve_app:fve_dev@localhost:5432/fve_dev

# Puerto y host donde escucha la API. El proxy de la web apunta a 3001.
PORT=3001
HOST=127.0.0.1

# Sincronización de la tasa del BCV. `off` la apaga (útil sin internet o en local).
# BCV_SYNC=off
# Cada cuántos minutos sincronizar (por defecto 60).
# BCV_SYNC_MINUTES=60

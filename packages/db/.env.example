# Base de datos de desarrollo. En producción esta cadena viene del entorno,
# nunca de un archivo versionado. Usa el rol de aplicación (no superusuario).
DATABASE_URL=postgres://fve_app:fve_dev@localhost:5432/fve_dev

# Base SEPARADA para las pruebas: `npm test` la toma de aquí, así no trunca
# los datos de desarrollo. Créala con: CREATE DATABASE fve_test OWNER fve_app.
TEST_DATABASE_URL=postgres://fve_app:fve_dev@localhost:5432/fve_test
